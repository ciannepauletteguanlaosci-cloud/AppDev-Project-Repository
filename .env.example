# Copy to .env and set a server-side Google AI Studio API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set 0.0.0.0 to allow phones on the same local network.
PENNY_BIND_HOST=127.0.0.1
# Brankas sandbox credentials with Statement access for test account linking (server-side only).
BRANKAS_API_KEY=
BRANKAS_ENVIRONMENT=sandbox
# Email password recovery. Use your provider's SMTP credentials, kept server-side.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional reserved login with email-only recovery; wallet and receipt features are open to all users.
PENNY_WALLET_PREVIEW_EMAIL=
